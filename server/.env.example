# Server Port
PORT=5000

# CORS Allowed Origins (Comma-separated origins or extension IDs)
# For development, chrome-extension://* or localhost is allowed
ALLOWED_ORIGINS=http://localhost:5000,chrome-extension://*

# AI Provider Configuration: 'gemini' or 'openai' or 'custom'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# Environment
NODE_ENV=development
